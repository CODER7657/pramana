# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Every provider is optional. PRAMANA runs, tests, and demos with none of them
# set -- the AI layer degrades to deterministic templates. Keys only make the
# explanations, dispute narratives and triage notes prose instead of templated.

# Cerebras -- https://cloud.cerebras.ai -> API Keys -> Create API Key
# Free tier: 1M tokens/day, 14,400 req/day/model, 8K context. No card.
CEREBRAS_API_KEY=

# Groq -- https://console.groq.com -> API Keys -> Create API Key
# Free tier: ~30 req/min, 1,000 req/day. No card. Fastest first token.
GROQ_API_KEY=

# NVIDIA NIM -- https://build.nvidia.com -> any model -> Get API Key
# NOTE: free tier is DEVELOPMENT/TESTING ONLY. Production use requires an
# NVIDIA AI Enterprise licence. Last in the fallback chain for that reason.
NVIDIA_API_KEY=
